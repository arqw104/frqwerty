
default partial alphanumeric_keys 
xkb_symbols "basic" {

    name[Group1]= "french-qwerty-layout";

    key <TLDE> { [ 	grave,  asciitilde		  ] };
    key <AE01> { [	1,		exclam		  ] };
    key <AE02> { [	2,		agrave,		  at,  Agrave				] };
    key <AE03> { [	3,		eacute,		  numbersign,  Eacute	] };
    key <AE04> { [	4,		dollar,		  EuroSign			] };
    key <AE05> { [	5,		dead_diaeresis, percent		 		] };
    key <AE06> { [	6,		dead_circumflex, asciicircum] };
    key <AE07> { [	7,		egrave,		  ampersand,   Egrave		] };
    key <AE08> { [	8,		asterisk		  ] };
    key <AE09> { [	9,		parenleft	  ] };
    key <AE10> { [	0,		parenright,	  degree				] };
    key <AE11> { [ 	minus,  underscore  ] };
    key <AE12> { [ 	equal,  plus		  ] };

    key <AD01> { [	q,	Q		] };
    key <AD02> { [	w,	W		] };
    key <AD03> { [	e,	E		] };
    key <AD04> { [	r,	R		] };
    key <AD05> { [	t,	T		] };
    key <AD06> { [	y,	Y		] };
    key <AD07> { [	u,	U,		ugrave, Ugrave	] };
    key <AD08> { [	i,	I					] };
    key <AD09> { [	o,	O,		oe, OE			] };
    key <AD10> { [	p,	P					] };
    key <AD11> { [ 	bracketleft,  braceleft	] };
    key <AD12> { [ 	bracketright, braceright		] };

    key <AC01> { [	a,	A, ae, AE 	] };
    key <AC02> { [	s,	S		] };
    key <AC03> { [	d,	D		] };
    key <AC04> { [	f,	F		] };
    key <AC05> { [	g,	G		] };
    key <AC06> { [	h,	H		] };
    key <AC07> { [	j,	J		] };
    key <AC08> { [	k,	K		] };
    key <AC09> { [	l,	L		] };
    key <AC10> { [	semicolon, colon	] };
    key <AC11> { [ 	apostrophe, quotedbl, acute ] };

    key <AB01> { [	z,	Z		] };
    key <AB02> { [	x,	X		] };
    key <AB03> { [	c,	C, ccedilla, Ccedilla ] };
    key <AB04> { [	v,	V		] };
    key <AB05> { [	b,	B		] };
    key <AB06> { [	n,	N		] };
    key <AB07> { [	m,	M		] };
    key <AB08> { [ 	comma,	less, guillemotleft	] };
    key <AB09> { [ 	period,	greater, guillemotright	] };
    key <AB10> { [ 	slash,	question	] };

    include "level3(ralt_switch)"
};

//------------------------------------
//l : letters, numbers

partial alphanumeric_keys modifier_keys
xkb_symbols "l" {
	include "frs(basic)"
    name[Group1]= "french-qwerty, letters-numbers";

	key <TLDE> { [ 	grave,				asciitilde 	] };
    key <AE01> { [	exclam,				1			] };
    key <AE02> { [	agrave,				2,			at,			Agrave	] };
    key <AE03> { [	eacute,				3,			numbersign, Eacute	] };
    key <AE04> { [	dollar,				4,			EuroSign	] };
    key <AE05> { [	dead_diaeresis,	5,			percent		] };
    key <AE06> { [	dead_circumflex,	6,			asciicircum	] };
    key <AE07> { [	egrave,				7,			ampersand,	Egrave	] };
    key <AE08> { [	asterisk,			8			] };
    key <AE09> { [	parenleft,			9			] };
    key <AE10> { [	parenright,			0,			degree		] };
    key <AE11> { [ 	minus,				underscore	] };
    key <AE12> { [ 	equal,				plus		] };

    include "level3(ralt_switch)"
};

